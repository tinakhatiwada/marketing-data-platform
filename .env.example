# Copy to .env for local live runs. Never commit .env.
# In production these come from Cloud Run env vars + Secret Manager.

# ---- Warehouse ------------------------------------------------------------------
ADPULSE_TARGET=local                 # local (DuckDB) | bigquery
GCP_PROJECT=your-gcp-project
BQ_LOCATION=australia-southeast1
RAW_DATASET=raw
OPS_DATASET=ops
ANALYTICS_DATASET=analytics

# ---- Behaviour ------------------------------------------------------------------
REPORTING_TIMEZONE=Australia/Sydney
LOOKBACK_DAYS=30
SLACK_WEBHOOK_URL=                   # optional: https://hooks.slack.com/services/...

# ---- Google OAuth2 (GA4 + Google Ads) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- GA4 --------------------------------------------------------------------------
GA4_PROPERTY_IDS=123456789,987654321

# ---- Google Ads -------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=        # manager (MCC) account id, if accounts sit under one
GOOGLE_ADS_CUSTOMER_IDS=1234567890
GOOGLE_ADS_API_VERSION=v26

# ---- Meta Marketing API -------------------------------------------------------------
META_ACCESS_TOKEN=                   # long-lived System User token
META_APP_SECRET=                     # optional: enables appsecret_proof
META_AD_ACCOUNT_IDS=act_1234567890
META_API_VERSION=v26.0
